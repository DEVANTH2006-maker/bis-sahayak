# ╔══════════════════════════════════════════════════════════════╗
# ║  BIS Mitra — Environment Variables (100% FREE setup)        ║
# ╚══════════════════════════════════════════════════════════════╝
# Copy this file to .env:  cp .env.example .env

# ── Option 1: Ollama (RECOMMENDED — completely free, offline) ──
# Install: curl -fsSL https://ollama.com/install.sh | sh
# Then:     ollama pull llama3.1:8b
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── Option 2: Google Gemini free tier (no credit card needed) ──
# Get key: https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-free-key-here
# GEMINI_MODEL=gemini-1.5-flash

# ── Option 3: OpenAI (paid — skip if using free options) ──
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here

# ── Embeddings (always free, runs locally) ──
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── ChromaDB (always free, runs locally) ──
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=bis_standards

# ── RAG settings ──
RAG_TOP_K=5
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100

# ── App ──
CORS_ORIGINS=["http://localhost:3000"]
DEBUG=true
